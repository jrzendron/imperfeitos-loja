# Copie para .dev.vars (que NUNCA vai para o Git).
# Ambiente local isolado: banco D1 local e credenciais de teste somente.
APP_ENV=development
#
# Token do painel administrativo. Vale SÓ para desenvolvimento local:
# em produção o /admin é protegido pelo Cloudflare Access (Fase 11)
# e esta variável deixa de existir.
ADMIN_TOKEN=dev-token-local

# Usado para derivar o hash dos tokens de retirada.
QR_TOKEN_SECRET=dev-qr-secret-local-nao-usar-em-producao

# Chave usada no HMAC do CPF. O banco nunca armazena o CPF em claro.
CPF_PEPPER=dev-cpf-pepper-local-nao-usar-em-producao

# Use apenas Testes > Credenciais de teste da aplicação Mercado Pago.
# Nunca coloque aqui credenciais de produção para experimentar o checkout.
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-token-de-teste
MERCADO_PAGO_WEBHOOK_SECRET=assinatura-secreta-do-webhook
MERCADO_PAGO_PUBLIC_KEY=TEST-chave-publica-de-teste

# Chave base64 aleatória de 32 bytes para cifrar futuras contas cadastradas no painel.
# Gere uma chave própria; nunca use a mesma chave em desenvolvimento e produção.
# PAYMENT_CONFIG_KEY=<base64-de-32-bytes>
