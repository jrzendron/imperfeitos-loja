{
  "name": "igreja-loja",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "db:migrate:local": "node scripts/migrate.mjs local",
    "db:migrate:remote": "node scripts/migrate.mjs remote",
    "db:seed:local": "wrangler d1 execute igreja-loja --local --file=./db/seeds/development.sql",
    "db:reset": "node scripts/reset.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "node tests/e2e/invariantes.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.95.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "hono": "^4.6.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  }
}
