{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imperfeitos-loja-homologacao",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "igreja-loja-homologacao",
      "database_id": "49d7710b-2072-4348-8cb0-9ff97261e2c6"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "igreja-loja-media-homologacao"
    }
  ],
  "triggers": { "crons": ["*/10 * * * *"] },
  "vars": {
    "APP_NAME": "3º Flow Blumenau | Homologação",
    "APP_ENV": "staging",
    "ORDER_PREFIX": "TEST",
    "ORDER_EXPIRATION_MINUTES": "30"
  }
}
