{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imperfeitos-loja",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],

  // Os arquivos estáticos são servidos direto, sem invocar o Worker.
  // É o que mantém a casca do PWA fora da cota de requisições.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "igreja-loja",
      // Banco de produção. No desenvolvimento local, o Wrangler mantém uma
      // cópia isolada em .wrangler e não acessa este banco remoto.
      "database_id": "d8cfa277-4cdb-4419-a66f-00f9b4b9a1d2"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "igreja-loja-media"
    }
  ],

  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  "vars": {
    "APP_NAME": "3º Flow Blumenau | Expansão",
    "APP_ENV": "production",
    "ORDER_PREFIX": "PED",
    "ORDER_EXPIRATION_MINUTES": "30"
  }
}
